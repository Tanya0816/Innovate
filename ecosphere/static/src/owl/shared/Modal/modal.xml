<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ecosphere.Modal" owl="1">
        <div class="o_eco_modal_backdrop" t-on-click.self="close">
            <div class="o_eco_modal">
                <div class="o_eco_modal_header">
                    <span t-esc="props.title"/>
                    <button class="o_eco_modal_close" t-on-click="close">&#215;</button>
                </div>
                <div class="o_eco_modal_body">
                    <t t-slot="default"/>
                </div>
            </div>
        </div>
    </t>
</templates>
