<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action mounting the OWL Executive Dashboard component -->
    <record id="action_executive_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">ecosphere.executive_dashboard</field>
    </record>

    <menuitem id="menu_ecosphere_root"
              name="EcoSphere"
              sequence="10"/>

    <menuitem id="menu_executive_dashboard"
              name="Executive Dashboard"
              parent="menu_ecosphere_root"
              action="action_executive_dashboard"
              sequence="1"/>

    <!-- Backend form view for a single department.score snapshot (drill-down) -->
    <record id="view_department_score_form" model="ir.ui.view">
        <field name="name">department.score.form</field>
        <field name="model">department.score</field>
        <field name="arch" type="xml">
            <form string="Department ESG Score" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="department_id"/>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="grade"/>
                    </group>
                    <group string="Pillar Scores">
                        <field name="environment_score"/>
                        <field name="social_score"/>
                        <field name="governance_score"/>
                        <field name="overall_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_department_score_list" model="ir.ui.view">
        <field name="name">department.score.list</field>
        <field name="model">department.score</field>
        <field name="arch" type="xml">
            <list string="Department ESG Scores" create="0" edit="0">
                <field name="department_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="environment_score"/>
                <field name="social_score"/>
                <field name="governance_score"/>
                <field name="overall_score"/>
                <field name="grade"/>
            </list>
        </field>
    </record>

    <record id="action_department_score" model="ir.actions.act_window">
        <field name="name">Department Scores</field>
        <field name="res_model">department.score</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_department_scores"
              name="Department Scores"
              parent="menu_ecosphere_root"
              action="action_department_score"
              sequence="2"/>
</odoo>
