<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_compliance_issue_tree" model="ir.ui.view">
        <field name="name">esg.compliance.issue.tree</field>
        <field name="model">esg.compliance.issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="title"/>
                <field name="audit_id"/>
                <field name="severity"/>
                <field name="owner"/>
                <field name="due_date"/>
                <field name="is_overdue"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_compliance_issue_form" model="ir.ui.view">
        <field name="name">esg.compliance.issue.form</field>
        <field name="model">esg.compliance.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="audit_id"/>
                    </group>
                    <group>
                        <field name="severity"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="owner"/>
                        <field name="due_date"/>
                        <field name="is_overdue" readonly="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_compliance_issue" model="ir.actions.act_window">
        <field name="name">Compliance Issues</field>
        <field name="res_model">esg.compliance.issue</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
