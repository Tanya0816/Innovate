<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_environment_goal_tree" model="ir.ui.view">
        <field name="name">esg.environment.goal.tree</field>
        <field name="model">esg.environment.goal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department_id"/>
                <field name="target_value"/>
                <field name="unit"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_environment_goal_form" model="ir.ui.view">
        <field name="name">esg.environment.goal.form</field>
        <field name="model">esg.environment.goal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="department_id"/>
                    </group>

                    <group>
                        <field name="target_value"/>
                        <field name="unit"/>
                    </group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="status"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                    <group>
                        <field name="active"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
