<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_department_tree" model="ir.ui.view">
        <field name="name">esg.department.tree</field>
        <field name="model">esg.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="head"/>
            </tree>
        </field>
    </record>

    <record id="view_department_form" model="ir.ui.view">
        <field name="name">esg.department.form</field>
        <field name="model">esg.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="head"/>
                        <field name="parent_department_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
