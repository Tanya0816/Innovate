<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_policy_tree" model="ir.ui.view">
        <field name="name">esg.policy.tree</field>
        <field name="model">esg.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="policy_code"/>
                <field name="title"/>
                <field name="category"/>
                <field name="effective_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_policy_form" model="ir.ui.view">
        <field name="name">esg.policy.form</field>
        <field name="model">esg.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="policy_code"/>
                        <field name="title"/>
                    </group>

                    <group>
                        <field name="category"/>
                        <field name="effective_date"/>
                        <field name="status"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                    <group>
                        <field name="active"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
