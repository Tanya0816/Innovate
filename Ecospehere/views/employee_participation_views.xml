<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_participation_tree" model="ir.ui.view">
        <field name="name">esg.employee.participation.tree</field>
        <field name="model">esg.employee.participation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="activity_id"/>
                <field name="approval_status"/>
                <field name="points_earned"/>
                <field name="completion_date"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_participation_form" model="ir.ui.view">
        <field name="name">esg.employee.participation.form</field>
        <field name="model">esg.employee.participation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="employee_id"/>
                        <field name="activity_id"/>
                    </group>

                    <group>
                        <field name="proof" filename="proof_filename"/>
                        <field name="approval_status"/>
                    </group>

                    <group>
                        <field name="points_earned" readonly="1"/>
                        <field name="completion_date"/>
                    </group>

                    <group>
                        <field name="remarks"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>