<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_challenge_participation_tree" model="ir.ui.view">
        <field name="name">esg.challenge.participation.tree</field>
        <field name="model">esg.challenge.participation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="challenge_id"/>
                <field name="progress"/>
                <field name="approval_status"/>
                <field name="points_earned"/>
                <field name="completion_date"/>
            </tree>
        </field>
    </record>

    <record id="view_challenge_participation_form" model="ir.ui.view">
        <field name="name">esg.challenge.participation.form</field>
        <field name="model">esg.challenge.participation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="challenge_id"/>
                    </group>
                    <group>
                        <field name="progress"/>
                        <field name="approval_status"/>
                    </group>
                    <group>
                        <field name="proof" filename="proof_filename"/>
                        <field name="proof_filename" invisible="1"/>
                        <field name="points_earned" readonly="1"/>
                        <field name="completion_date"/>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_challenge_participation" model="ir.actions.act_window">
        <field name="name">Challenge Participations</field>
        <field name="res_model">esg.challenge.participation</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
