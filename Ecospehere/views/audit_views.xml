<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_audit_tree" model="ir.ui.view">
        <field name="name">esg.audit.tree</field>
        <field name="model">esg.audit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="audit_name"/>
                <field name="department_id"/>
                <field name="auditor"/>
                <field name="audit_type"/>
                <field name="audit_date"/>
                <field name="severity"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_audit_form" model="ir.ui.view">
        <field name="name">esg.audit.form</field>
        <field name="model">esg.audit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="audit_name"/>
                        <field name="audit_type"/>
                    </group>
                    <group>
                        <field name="department_id"/>
                        <field name="auditor"/>
                    </group>
                    <group>
                        <field name="audit_date"/>
                        <field name="severity"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_audit" model="ir.actions.act_window">
        <field name="name">Audits</field>
        <field name="res_model">esg.audit</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
