<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_department_score_tree" model="ir.ui.view">
        <field name="name">esg.department.score.tree</field>
        <field name="model">esg.department.score</field>
        <field name="arch" type="xml">
            <tree>
                <field name="department_id"/>
                <field name="score_date"/>
                <field name="environment_score"/>
                <field name="social_score"/>
                <field name="governance_score"/>
                <field name="overall_score"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_department_score_form" model="ir.ui.view">
        <field name="name">esg.department.score.form</field>
        <field name="model">esg.department.score</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="department_id"/>
                        <field name="score_date"/>
                    </group>

                    <group>
                        <field name="environment_score"/>
                        <field name="social_score"/>
                        <field name="governance_score"/>
                        <field name="overall_score" readonly="1"/>
                    </group>

                    <group>
                        <field name="status"/>
                        <field name="remarks"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>